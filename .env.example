# 加密密钥：数据源密码和 AI key 都用它加密后落盘
# 改了它，之前保存的密码就解不开了
MASTER_KEY=change-me-to-a-long-random-string

# 首次启动时创建的管理员（登录后请立刻改）
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# 以下一般不用改，start.sh 会按目录自动设置
# DATA_DIR=./data
# PROJECTS_DIR=./businesses
# CATALOG_DIR=./runtime/trino/etc/catalog
# TRINO_URL=http://127.0.0.1:8888